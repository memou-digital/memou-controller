# ============================================================
# MEMOu Controller Studio - Environment Configuration
# ============================================================

# 1. DATABASE (TiDB Cloud Serverless MySQL)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:4000/<DATABASE>?ssl={"rejectUnauthorized":true}
DATABASE_URL="mysql://26kvHu72gLLfrEM.root:0HxlqiyABrjYj9F0@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/sys?sslaccept=strict"

# 2. GITHUB CLOUD INTEGRATION (Personal Access Token & Organizations)
# Generate from: GitHub Settings > Developer Settings > Personal Access Tokens (classic)
# Required Scopes: repo, workflow
GITHUB_TOKEN="ghp_your_github_personal_access_token_here"
GITHUB_TEMPLATES_ORG="memou-templates"
GITHUB_CLIENTS_ORG="memou-clients"

# 3. VERCEL AUTO-DEPLOYMENT INTEGRATION
# Gunakan MEMOU_VERCEL_TOKEN agar tidak bentrok dengan reserved variable Vercel Cloud
# Generate from: Vercel Dashboard > Account Settings > Tokens
MEMOU_VERCEL_TOKEN="your_vercel_api_token_here"
MEMOU_VERCEL_TEAM_ID="" # Optional if using team account
# Fallback lokal:
VERCEL_TOKEN="your_vercel_api_token_here"
VERCEL_TEAM_ID=""
